{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext", 
    "moduleResolution": "NodeNext", 
    "target": "ES2020",
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true, 
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"]
}